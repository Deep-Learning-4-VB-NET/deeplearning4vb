Namespace org.datavec.api.split.partition

    ''' <summary>
    ''' What a record writer reports back to a <see cref="Partitioner"/> after writing: the number of
    ''' records and bytes added. Lombok's <c>@Builder</c> is kept as <see cref="builder"/>.
    ''' </summary>
    <Serializable>
    Public Class PartitionMetaData

        Private numRecordsUpdatedValue As Integer
        Private sizeUpdatedValue As Long

        Public Sub New()
        End Sub

        Public Sub New(ByVal numRecordsUpdated As Integer, ByVal sizeUpdated As Long)
            Me.numRecordsUpdatedValue = numRecordsUpdated
            Me.sizeUpdatedValue = sizeUpdated
        End Sub

        Public Shared Function builder() As PartitionMetaDataBuilder
            Return New PartitionMetaDataBuilder()
        End Function

        Public Function getNumRecordsUpdated() As Integer
            Return numRecordsUpdatedValue
        End Function

        Public Function getSizeUpdated() As Long
            Return sizeUpdatedValue
        End Function

        Public ReadOnly Property NumRecordsUpdated As Integer
            Get
                Return numRecordsUpdatedValue
            End Get
        End Property

        Public ReadOnly Property SizeUpdated As Long
            Get
                Return sizeUpdatedValue
            End Get
        End Property

        ''' <summary>The builder generated by Lombok's <c>@Builder</c> in Java.</summary>
        Public Class PartitionMetaDataBuilder

            Private numRecordsUpdatedValue As Integer
            Private sizeUpdatedValue As Long

            Friend Sub New()
            End Sub

            Public Function numRecordsUpdated(ByVal value As Integer) As PartitionMetaDataBuilder
                Me.numRecordsUpdatedValue = value
                Return Me
            End Function

            Public Function sizeUpdated(ByVal value As Long) As PartitionMetaDataBuilder
                Me.sizeUpdatedValue = value
                Return Me
            End Function

            Public Function build() As PartitionMetaData
                Return New PartitionMetaData(numRecordsUpdatedValue, sizeUpdatedValue)
            End Function

            Public Overrides Function ToString() As String
                Return "PartitionMetaData.PartitionMetaDataBuilder(numRecordsUpdated=" & numRecordsUpdatedValue & ", sizeUpdated=" & sizeUpdatedValue & ")"
            End Function

        End Class

    End Class

End Namespace
