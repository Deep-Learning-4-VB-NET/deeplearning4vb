<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- .NET Framework 4.8.1 for existing Framework applications, .NET 10 for speed (SIMD intrinsics, the newer JIT). -->
    <TargetFrameworks>net481;net10.0</TargetFrameworks>
    <OutputType>Library</OutputType>
    <RootNamespace>DeepLearning4VB</RootNamespace>
    <AssemblyName>DeepLearning4VB</AssemblyName>
    <OptionStrict>Off</OptionStrict>
    <NoWarn>$(NoWarn);42016;41999;42017;42018;42019;42032;42036;42020;42021;42022</NoWarn>
  </PropertyGroup>

  <!-- On .NET 10 these assemblies and System.Text.Json are part of the shared framework. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net481'">
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Numerics" />
    <PackageReference Include="System.Text.Json" Version="9.0.4" />
  </ItemGroup>

  <ItemGroup>
    <Import Include="System" />
    <Import Include="System.Collections.Generic" />
    <Import Include="System.Linq" />
    <Import Include="Microsoft.VisualBasic" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DeepLearning4VB.Tests" />
  </ItemGroup>

</Project>
